# Port the backend HTTP + WebSocket server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS + Socket.IO
# In local dev this is the Vite dev server. In production this must be
# your deployed frontend's HTTPS origin(s), e.g.:
# CLIENT_ORIGIN=https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection string (orders + location history). Get a free one
# from https://neon.tech — create a project, copy the "Connection string"
# (use the pooled connection for the app; Prisma migrations can use either).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
