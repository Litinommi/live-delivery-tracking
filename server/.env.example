# Port the backend HTTP + WebSocket server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS + Socket.IO
# In local dev this is the Vite dev server. In production this must be
# your deployed frontend's HTTPS origin(s), e.g.:
# CLIENT_ORIGIN=https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
